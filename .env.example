# --- Notion ---
# Token de una integración interna: https://www.notion.so/profile/integrations
# Luego, en la base de datos de tareas: ••• → Conexiones → agrega la integración.
NOTION_TOKEN=
# ID de la base de datos (los 32 caracteres del link, antes de "?v=")
NOTION_DATABASE_ID=

# --- Acceso ---
# Clave de tu jefe (solo lectura).
ACCESS_KEY=
# Tu clave (marca la jornada y ve las visitas de tu jefe)
OWNER_KEY=
# Opcional: secreto para firmar la cookie de sesión. Si lo cambias, todos deben volver a entrar.
SESSION_SECRET=

# --- Presentación ---
OWNER_NAME=Diego
TIMEZONE=America/Tegucigalpa

# --- Columnas de Notion (opcional) ---
# Si se dejan vacías se detectan solas: título, primera fecha, primera casilla/estado y etiquetas.
PROP_TITLE=
PROP_DATE=
PROP_DONE=
PROP_TAGS=
# Si "Done" es una propiedad de tipo Estado, qué valores cuentan como terminado:
DONE_VALUES=Done,Listo,Hecho,Completado,Terminado

# Filtrar etiquetas (separadas por coma). INCLUDE gana sobre EXCLUDE.
INCLUDE_TAGS=
EXCLUDE_TAGS=

# Solo mostrar tareas con fecha desde este día (YYYY-MM-DD)
START_DATE=

# Cuántos días hacia atrás leer de Notion
HISTORY_DAYS=120
# Segundos que se guarda en caché la respuesta de Notion
CACHE_SECONDS=60

# DEMO=1 usa datos de ejemplo (se activa solo si no hay NOTION_TOKEN)
DEMO=

# --- Aviso cuando tu jefe abre el panel (opcional) ---
# Token del bot creado con @BotFather. Tú y tu jefe se vinculan desde el panel.
TELEGRAM_BOT_TOKEN=
# Opcional: no hace falta, el vínculo se hace con el botón del panel.
TELEGRAM_CHAT_ID=
# Minutos sin actividad para contar una visita nueva
VISIT_GAP_MINUTES=30
# Cada cuántos minutos revisar Notion para avisar al jefe de tareas completadas
WATCH_MINUTES=2
# Carpeta donde se guardan jornadas, visitas y vínculos de Telegram (en Railway: volumen en /data)
DATA_DIR=data
